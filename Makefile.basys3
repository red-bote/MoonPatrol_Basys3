# Basys3 (Vivado) build driver -- named Makefile.basys3, NOT Makefile: the
# root Makefile is the pristine upstream DeMiSTify framework's own build
# driver (Quartus-toolchain-hardcoded, MiST/MiSTer targets), untouched by
# this port. Usage: make -f Makefile.basys3 <target>. See
# contrib/basys3/PORTING_SPEC.md §0.
#
# Default target: build the whole scripted Basys3 port tree.
TOOLS        := contrib/tools
BASYS3_TOOLS := contrib/basys3/tools
VIVADO       := contrib/basys3/vivado

.PHONY: all setup create_prj clk_wiz patch synth bitstream clean help

all: setup clk_wiz patch

setup:
	$(TOOLS)/setup_moonpatrol.sh

create_prj:
	$(VIVADO)/create_project.sh

clk_wiz: setup create_prj
	$(VIVADO)/make_clk_wiz_0.sh

# Author moonpatrol_basys3.vhd (original -- no pristine DE10-lite/MiST top to
# diff against, see contrib/basys3/tools/make_moonpatrol_basys3_top.sh).
patch: setup
	$(BASYS3_TOOLS)/make_moonpatrol_basys3_top.sh

# Run synthesis only (resets synth_1 first).
synth: setup clk_wiz patch
	$(BASYS3_TOOLS)/make_moonpatrol_basys3_bitstream.sh synth

# Implementation + write_bitstream (depends on synthesis).
bitstream: synth
	$(BASYS3_TOOLS)/make_moonpatrol_basys3_bitstream.sh bitstream

# This port keeps its pristine source in place (no separate extracted
# archive tree -- see contrib/basys3/PORTING_SPEC.md §0); clean removes only
# the generated Vivado project tree, plus the ephemeral romset/PROM staging dir.
clean:
	rm -rf basys3 tools/roms tools/make_vhdl_prom

help:
	@echo "Moon Patrol Basys3 port driver."
	@echo "Usage: make -f Makefile.basys3 <target>"
	@echo
	@echo "  all         setup clk_wiz patch"
	@echo "  setup       apply dpram Xilinx-BRAM fix patch + rom-prep (no archive fetch, see PORTING_SPEC.md §0)"
	@echo "  create_prj  create Vivado project (copies .xpr/.xdc, imports scandoubler)"
	@echo "  clk_wiz     generate clk_wiz_0 MMCM IP (100 -> 30/12/14.31818 MHz; clock_v and clock_3p58 derived in fabric)"
	@echo "  patch       author moonpatrol_basys3.vhd top level"
	@echo "  synth       synthesis only (resets synth_1 first)"
	@echo "  bitstream   implementation + write_bitstream"
	@echo "  clean       remove the Vivado project tree + staged roms/PROM VHDL only"
