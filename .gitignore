# Basys3 (Vivado) port -- unzipped romset + compiled/converted rom-prep
# tools + generated PROM VHDL (copyrighted MAME-derived content) -- never
# commit, whole dir ignored.
/tools/roms/
/tools/make_vhdl_prom

# Vivado project build tree: fully ephemeral, regenerated by
# `make create_prj clk_wiz patch` from the tracked contrib/basys3/ assets
# (.xpr, Basys-3-Master.xdc, scandoubler.v, the authored top-level .vhd).
# `make clean` removes this directory wholesale (this port has no separate
# extracted archive tree to remove -- the pristine source is this repo's
# own rtl/, tracked normally).
/basys3/
*.jou
*.log
*.str
*.wdb

# Extra safety net against committing romset zips
*.zip
